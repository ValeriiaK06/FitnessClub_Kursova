<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Бренд -->
    <Color x:Key="Brand">#2563EB</Color>
    <Color x:Key="BrandDark">#1D4ED8</Color>
    <Color x:Key="BrandLight">#3B82F6</Color>
    <Color x:Key="Accent">#06B6D4</Color>
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Danger">#EF4444</Color>

    <!-- Фон сторінки: світла / темна -->
    <Color x:Key="PageBgLight">#F1F5F9</Color>
    <Color x:Key="PageBgDark">#0B1120</Color>

    <!-- Поверхня (картки): світла / темна -->
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1E293B</Color>

    <!-- Підвищена поверхня (хедер, банер) -->
    <Color x:Key="ElevatedLight">#FFFFFF</Color>
    <Color x:Key="ElevatedDark">#162033</Color>

    <!-- Текст основний / вторинний -->
    <Color x:Key="TextLight">#0F172A</Color>
    <Color x:Key="TextDark">#F1F5F9</Color>
    <Color x:Key="SubTextLight">#64748B</Color>
    <Color x:Key="SubTextDark">#94A3B8</Color>

    <!-- Межі -->
    <Color x:Key="BorderLight">#E2E8F0</Color>
    <Color x:Key="BorderDark">#334155</Color>

    <!-- Службові -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#020617</Color>

    <!-- Сумісність зі старим кодом (щоб нічого не зламалось одразу) -->
    <Color x:Key="Primary">#2563EB</Color>
    <Color x:Key="Secondary">#1E293B</Color>
    <Color x:Key="Tertiary">#06B6D4</Color>
    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource Brand}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>

</ResourceDictionary>