<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessClub.Views.AppFooter">
    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource ElevatedLight}, Dark={StaticResource ElevatedDark}}"
          Padding="20,16">
        <VerticalStackLayout Spacing="12">

            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>

            <!-- Назва клубу -->
            <Label Text="💪 FitnessClub" FontFamily="OpenSansSemibold"
                   FontSize="16" TextColor="{StaticResource Brand}"/>

            <!-- Контакти -->
            <VerticalStackLayout Spacing="4">
                <Label Text="📍 вул. Спортивна, 15, Одеса" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}"/>
                <Label Text="📞 +38 (048) 123-45-67" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}"/>
                <Label Text="✉️ info@fitnessclub.ua" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}"/>
                <Label Text="🕐 Пн–Пт 06:00–23:00 · Сб–Нд 08:00–21:00" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}"/>
            </VerticalStackLayout>

            <!-- Соцмережі -->
            <HorizontalStackLayout Spacing="10">
                <Border BackgroundColor="{StaticResource Brand}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20" HeightRequest="40" WidthRequest="40">
                    <Label Text="📘" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Border BackgroundColor="{StaticResource Brand}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20" HeightRequest="40" WidthRequest="40">
                    <Label Text="📷" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Border BackgroundColor="{StaticResource Brand}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20" HeightRequest="40" WidthRequest="40">
                    <Label Text="▶️" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Border BackgroundColor="{StaticResource Brand}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20" HeightRequest="40" WidthRequest="40">
                    <Label Text="✈️" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </HorizontalStackLayout>

			<!-- Копірайт -->
			<Label Text="© 2026 FitnessClub · Усі права захищені"
                   FontSize="11"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}"/>
        </VerticalStackLayout>
    </Grid>
</ContentView>