<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessClub.Views.AppHeader">
	<Grid HeightRequest="80"
          BackgroundColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource SurfaceDark}}">
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
            <Label Text="💪 FitnessClub" FontFamily="OpenSansSemibold"
                   FontSize="20" TextColor="{StaticResource White}"
                   HorizontalTextAlignment="Center"/>
            <Label Text="Панель адміністратора" FontSize="11"
                   TextColor="{StaticResource Gray200}"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentView>