<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FitnessClub.Models"
             xmlns:vm="clr-namespace:FitnessClub.ViewModels"
             xmlns:views="clr-namespace:FitnessClub.Views"
             x:Class="FitnessClub.Views.BookingsPage"
             x:DataType="vm:BookingsViewModel"
             x:Name="PageRoot"
             Title="">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <views:AppHeader/>

            <VerticalStackLayout Padding="20,20,20,0" Spacing="16">

                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="📝 Записи клієнтів" Style="{StaticResource PageTitle}"/>
                        <Label Text="Записи на тренування" Style="{StaticResource SubtitleLabel}"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="1" Text="＋"
                            Command="{Binding AddCommand}"
                            FontSize="22" FontAttributes="Bold"
                            WidthRequest="48" HeightRequest="48"
                            Padding="0" CornerRadius="14"
                            VerticalOptions="Center"/>
                </Grid>
                
                <Border Style="{StaticResource InputFrame}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="🔍" FontSize="16"
                               VerticalOptions="Center" Margin="0,0,8,0"/>
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Пошук за іменем або прізвищем клієнта"/>
                    </Grid>
                </Border>

                <FlexLayout BindableLayout.ItemsSource="{Binding Bookings}"
                            Wrap="Wrap" JustifyContent="Start" AlignItems="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ClientBooking">

                            <Border Style="{StaticResource Card}"
                                    FlexLayout.Basis="320"
                                    FlexLayout.Shrink="0"
                                    FlexLayout.Grow="1"
                                    Margin="7"
                                    Padding="16">
                                <VerticalStackLayout Spacing="10">

                                    <!-- Клієнт + статус -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding ClientName}"
                                               FontFamily="OpenSansSemibold" FontSize="16"
                                               TextColor="{StaticResource Brand}"/>
                                        <Border Grid.Column="1"
                                                BackgroundColor="{Binding IsActive, Converter={StaticResource ActiveColorConverter}}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                                Padding="9,3" VerticalOptions="Center">
                                            <Label FontSize="10" TextColor="{StaticResource White}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Text" Value="Активний"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Text" Value="Минув"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </Grid>

                                    <BoxView HeightRequest="1"
                                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>

                                    <Label Text="{Binding ScheduleName, StringFormat='🏋️ {0}'}"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"/>
                                    <Label Text="{Binding TrainerName, StringFormat='👨‍🏫 {0}'}"
                                           Style="{StaticResource SubtitleLabel}"/>
                                    <Label Text="{Binding DayOfWeek, StringFormat='📆 {0}'}"
                                           Style="{StaticResource SubtitleLabel}"/>
                                    <Label Text="{Binding BookingDate, StringFormat='🕐 {0:dd.MM.yyyy}'}"
                                           Style="{StaticResource SubtitleLabel}"/>

                                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                        <Button Text="✏️"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditCommand}"
                                                CommandParameter="{Binding Id}"
                                                FontSize="13" Padding="0"
                                                WidthRequest="36" HeightRequest="36"
                                                CornerRadius="10"
                                                BackgroundColor="{StaticResource Brand}"/>
                                        <Button Text="🗑"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                                CommandParameter="{Binding Id}"
                                                FontSize="13" Padding="0"
                                                WidthRequest="36" HeightRequest="36"
                                                CornerRadius="10"
                                                BackgroundColor="{StaticResource Danger}"/>
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                            </Border>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

            </VerticalStackLayout>

            <BoxView HeightRequest="60" Color="Transparent"/>

            <views:AppFooter/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>