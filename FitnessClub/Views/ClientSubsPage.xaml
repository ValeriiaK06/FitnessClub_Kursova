<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FitnessClub.Models"
             xmlns:vm="clr-namespace:FitnessClub.ViewModels"
             xmlns:views="clr-namespace:FitnessClub.Views"
             x:Class="FitnessClub.Views.ClientSubsPage"
             x:DataType="vm:ClientSubsViewModel"
             x:Name="PageRoot"
             Title="">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <views:AppHeader/>

            <VerticalStackLayout Padding="20,20,20,0" Spacing="16">

                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="📋 Абонементи клієнтів" Style="{StaticResource PageTitle}"/>
                        <Label Text="Керування підписками" Style="{StaticResource SubtitleLabel}"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="1" Text="＋"
                            Command="{Binding AddCommand}"
                            FontSize="22" FontAttributes="Bold"
                            WidthRequest="48" HeightRequest="48"
                            Padding="0" CornerRadius="14"
                            VerticalOptions="Center"/>
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ClientSubscription">

                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">

                                    <!-- Клієнт -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding ClientName}"
                                           FontFamily="OpenSansSemibold" FontSize="16"
                                           TextColor="{StaticResource Brand}"/>

                                    <!-- Статус -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                            BackgroundColor="{Binding IsExpired, Converter={StaticResource StatusColorConverter}}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                            Padding="10,3" VerticalOptions="Center">
                                        <Label Text="{Binding StatusText}" FontSize="11"
                                               TextColor="{StaticResource White}"/>
                                    </Border>

                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding PlanName, StringFormat='💳 {0}'}"
                                           FontSize="14" Margin="0,6,0,0"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"/>

                                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding ExpiryDate, StringFormat='Діє до: {0:dd.MM.yyyy}'}"
                                           Style="{StaticResource SubtitleLabel}" Margin="0,2,0,0"/>

                                    <!-- Кнопки -->
                                    <HorizontalStackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                           Spacing="8" Margin="0,10,0,0">
                                        <Button Text="✏️"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditCommand}"
                                                CommandParameter="{Binding Id}"
                                                FontSize="13" Padding="0"
                                                WidthRequest="36" HeightRequest="36"
                                                CornerRadius="10"
                                                BackgroundColor="{StaticResource Brand}"/>
                                        <Button Text="🗑"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                                CommandParameter="{Binding Id}"
                                                FontSize="13" Padding="0"
                                                WidthRequest="36" HeightRequest="36"
                                                CornerRadius="10"
                                                BackgroundColor="{StaticResource Danger}"/>
                                    </HorizontalStackLayout>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>

            <BoxView HeightRequest="60" Color="Transparent"/>

            <views:AppFooter/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>