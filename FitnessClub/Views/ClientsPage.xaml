<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FitnessClub.Models"
             xmlns:vm="clr-namespace:FitnessClub.ViewModels"
             xmlns:views="clr-namespace:FitnessClub.Views"
             x:Class="FitnessClub.Views.ClientsPage"
             x:DataType="vm:ClientsViewModel"
             x:Name="PageRoot"
             Title="">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <views:AppHeader/>

            <VerticalStackLayout Padding="20,20,20,0" Spacing="16">

                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="👤 Клієнти" Style="{StaticResource PageTitle}"/>
                        <Label Text="Учасники клубу" Style="{StaticResource SubtitleLabel}"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="1" Text="＋"
                            Command="{Binding AddCommand}"
                            FontSize="22" FontAttributes="Bold"
                            WidthRequest="48" HeightRequest="48"
                            Padding="0" CornerRadius="14"
                            VerticalOptions="Center"/>
                </Grid>

                <FlexLayout BindableLayout.ItemsSource="{Binding Clients}"
                            Wrap="Wrap" JustifyContent="Center">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Client">

                            <Border Style="{StaticResource Card}"
                                    FlexLayout.Basis="350"
                                    FlexLayout.Shrink="0"
                                    FlexLayout.Grow="1"
                                    Margin="7"
                                    HeightRequest="420"
                                    Padding="0">
                                <Grid RowDefinitions="Auto,*,Auto">

                                    <!-- Спільне фото зверху -->
                                    <Border Grid.Row="0"
                                            StrokeShape="RoundRectangle 60"
                                            Stroke="{StaticResource Brand}"
                                            StrokeThickness="3"
                                            HeightRequest="110"
                                            WidthRequest="110"
                                            HorizontalOptions="Center"
                                            Margin="0,18,0,0"
                                            Padding="0">
                                        <Image Source="user.png" Aspect="AspectFill"/>
                                    </Border>

                                    <!-- Інформація -->
                                    <VerticalStackLayout Grid.Row="1" Spacing="6"
                                                         Padding="16,12,16,0"
                                                         VerticalOptions="Start">

                                        <Label HorizontalTextAlignment="Center"
                                               FontFamily="OpenSansSemibold" FontSize="17"
                                               TextColor="{StaticResource Brand}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding LastName}"/>
                                                    <Span Text=" "/>
                                                    <Span Text="{Binding FirstName}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Label Text="{Binding MiddleName}"
                                               HorizontalTextAlignment="Center"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}"/>

                                        <!-- Бейдж абонемента -->
                                        <Border BackgroundColor="{StaticResource Accent}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                                Padding="10,4" HorizontalOptions="Center" Margin="0,4">
                                            <Label Text="{Binding SubscriptionName, StringFormat='💳 {0}'}"
                                                   HorizontalTextAlignment="Center"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource White}"/>
                                        </Border>

                                        <BoxView HeightRequest="1" Margin="0,2"
                                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>

                                        <Label Text="{Binding BirthDate, StringFormat='🎂 {0:dd.MM.yyyy}'}"
                                               HorizontalTextAlignment="Center" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}"/>
                                        <Label Text="{Binding Phone, StringFormat='📞 {0}'}"
                                               HorizontalTextAlignment="Center" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}"/>
                                        <Label Text="{Binding Email, StringFormat='✉️ {0}'}"
                                               HorizontalTextAlignment="Center" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}"/>
                                        <Label Text="{Binding RegistrationDate, StringFormat='📅 з {0:dd.MM.yyyy}'}"
                                               HorizontalTextAlignment="Center" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}"/>
                                    </VerticalStackLayout>

                                    <!-- Кнопки -->
                                    <HorizontalStackLayout Grid.Row="2" Spacing="8"
                                                           HorizontalOptions="Center"
                                                           Padding="0,0,0,16">
                                        <Button Text="✏️"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditCommand}"
                                                CommandParameter="{Binding Id}"
                                                FontSize="14" Padding="0"
                                                WidthRequest="40" HeightRequest="40"
                                                CornerRadius="12"
                                                BackgroundColor="{StaticResource Brand}"/>
                                        <Button Text="🗑"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                                CommandParameter="{Binding Id}"
                                                FontSize="14" Padding="0"
                                                WidthRequest="40" HeightRequest="40"
                                                CornerRadius="12"
                                                BackgroundColor="{StaticResource Danger}"/>
                                    </HorizontalStackLayout>

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

            </VerticalStackLayout>

            <BoxView HeightRequest="60" Color="Transparent"/>

            <views:AppFooter/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>