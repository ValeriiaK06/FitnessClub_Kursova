<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:FitnessClub.Views"
             x:Class="FitnessClub.Views.DashboardPage"
             Title="">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ШАПКА -->
            <views:AppHeader/>

            <!-- КАРТИНКА-БАНЕР впритул -->
            <Image Source="banner.jpg"
                   Aspect="AspectFill"
                   HeightRequest="180"/>

            <!-- ОСНОВНИЙ КОНТЕНТ -->
            <VerticalStackLayout Padding="20,20,20,0" Spacing="20">

                <!-- БАНЕР з ім'ям адміністратора -->
                <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="0">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource Brand}" Offset="0"/>
                                <GradientStop Color="{StaticResource Accent}" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>

                        <VerticalStackLayout Padding="24" Spacing="10">

                            <!-- Звичайний режим -->
                            <Grid ColumnDefinitions="*,Auto"
                                  IsVisible="{Binding IsEditingName, Converter={StaticResource InvertBoolConverter}}">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Вітаємо 👋" FontSize="13"
                                           TextColor="{StaticResource Gray100}"/>
                                    <Label Text="{Binding AdminName}"
                                           FontFamily="OpenSansSemibold" FontSize="24"
                                           TextColor="{StaticResource White}"/>
                                    <Label Text="Панель адміністратора FitnessClub"
                                           FontSize="12" TextColor="{StaticResource Gray100}"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="1" Text="✏️"
                                        Command="{Binding StartEditNameCommand}"
                                        FontSize="16" Padding="0"
                                        WidthRequest="42" HeightRequest="42"
                                        CornerRadius="12"
                                        VerticalOptions="Center"
                                        BackgroundColor="{StaticResource White}"
                                        TextColor="{StaticResource Brand}"/>
                            </Grid>

                            <!-- Режим редагування -->
                            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsEditingName}">
                                <Label Text="Введіть ім'я адміністратора" FontSize="13"
                                       TextColor="{StaticResource White}"/>

                                <Border BackgroundColor="{StaticResource White}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                        Padding="12,0">
                                    <Entry Text="{Binding EditNameText}"
                                           Placeholder="Ім'я"
                                           TextColor="{StaticResource Gray900}"
                                           PlaceholderColor="{StaticResource Gray500}"/>
                                </Border>

                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="💾 Зберегти"
                                            Command="{Binding SaveNameCommand}"
                                            FontSize="14" HeightRequest="42"
                                            CornerRadius="12"
                                            BackgroundColor="{StaticResource White}"
                                            TextColor="{StaticResource Brand}"/>
                                    <Button Text="Скасувати"
                                            Command="{Binding CancelEditNameCommand}"
                                            FontSize="14" HeightRequest="42"
                                            CornerRadius="12"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource White}"
                                            BorderColor="{StaticResource White}"
                                            BorderWidth="1"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Статистика -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="14" RowSpacing="14">

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="👨‍🏫 Тренери" Style="{StaticResource SubtitleLabel}"/>
                            <Label Text="{Binding TrainersCount}" FontFamily="OpenSansSemibold"
                                   FontSize="30" TextColor="{StaticResource Brand}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="👤 Клієнти" Style="{StaticResource SubtitleLabel}"/>
                            <Label Text="{Binding ClientsCount}" FontFamily="OpenSansSemibold"
                                   FontSize="30" TextColor="{StaticResource Brand}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="💳 Абонементи" Style="{StaticResource SubtitleLabel}"/>
                            <Label Text="{Binding SubscriptionsCount}" FontFamily="OpenSansSemibold"
                                   FontSize="30" TextColor="{StaticResource Brand}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="✅ Активних абонементів" Style="{StaticResource SubtitleLabel}"/>
                            <Label Text="{Binding ActiveSubsCount}" FontFamily="OpenSansSemibold"
                                   FontSize="30" TextColor="{StaticResource Success}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📅 Занять" Style="{StaticResource SubtitleLabel}"/>
                            <Label Text="{Binding SchedulesCount}" FontFamily="OpenSansSemibold"
                                   FontSize="30" TextColor="{StaticResource Brand}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📝 Активних записів" Style="{StaticResource SubtitleLabel}"/>
                            <Label Text="{Binding BookingsCount}" FontFamily="OpenSansSemibold"
                                   FontSize="30" TextColor="{StaticResource Brand}"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

            </VerticalStackLayout>

            <!-- ВІЛЬНИЙ ПРОСТІР перед футером -->
            <BoxView HeightRequest="100" Color="Transparent"/>

            <!-- ФУТЕР -->
            <views:AppFooter/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>