<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:FitnessClub.Views"
             x:Class="FitnessClub.Views.DashboardPage"
             Title="">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ШАПКА (скролиться разом зі сторінкою) -->
            <views:AppHeader/>

            <!-- БАНЕР впритул до країв і до шапки -->
            <Image Source="banner.jpg"
                   Aspect="AspectFill"
                   HeightRequest="180"/>

            <!-- ОСНОВНИЙ КОНТЕНТ -->
            <VerticalStackLayout Padding="20,20,20,0" Spacing="20">

                <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="0">
                    <Grid HeightRequest="140">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource Brand}" Offset="0"/>
                                <GradientStop Color="{StaticResource Accent}" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <VerticalStackLayout Padding="24" VerticalOptions="Center" Spacing="6">
                            <Label Text="FitnessClub Admin" FontFamily="OpenSansSemibold"
                                   FontSize="22" TextColor="{StaticResource White}"/>
                            <Label Text="Керуйте тренерами, клієнтами та розкладом в одному місці"
                                   FontSize="13" TextColor="{StaticResource Gray100}"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Статистика -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="14" RowSpacing="14">

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="👨‍🏫 Тренери" Style="{StaticResource SubtitleLabel}"/>
                            <Label Text="{Binding TrainersCount}" FontFamily="OpenSansSemibold"
                                   FontSize="30" TextColor="{StaticResource Brand}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="👤 Клієнти" Style="{StaticResource SubtitleLabel}"/>
                            <Label Text="{Binding ClientsCount}" FontFamily="OpenSansSemibold"
                                   FontSize="30" TextColor="{StaticResource Brand}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="💳 Абонементи" Style="{StaticResource SubtitleLabel}"/>
                            <Label Text="{Binding SubscriptionsCount}" FontFamily="OpenSansSemibold"
                                   FontSize="30" TextColor="{StaticResource Brand}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="✅ Активних абонементів" Style="{StaticResource SubtitleLabel}"/>
                            <Label Text="{Binding ActiveSubsCount}" FontFamily="OpenSansSemibold"
                                   FontSize="30" TextColor="{StaticResource Success}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📅 Занять" Style="{StaticResource SubtitleLabel}"/>
                            <Label Text="{Binding SchedulesCount}" FontFamily="OpenSansSemibold"
                                   FontSize="30" TextColor="{StaticResource Brand}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="📝 Активних записів" Style="{StaticResource SubtitleLabel}"/>
                            <Label Text="{Binding BookingsCount}" FontFamily="OpenSansSemibold"
                                   FontSize="30" TextColor="{StaticResource Brand}"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

            </VerticalStackLayout> 

            <!-- ВІЛЬНИЙ ПРОСТІР перед футером -->
            <BoxView HeightRequest="100" Color="Transparent"/>

            <!-- ФУТЕР -->
            <views:AppFooter/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>