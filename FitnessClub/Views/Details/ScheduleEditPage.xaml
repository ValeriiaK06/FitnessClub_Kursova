<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitnessClub.ViewModels"
             xmlns:views="clr-namespace:FitnessClub.Views"
             x:Class="FitnessClub.Views.Details.ScheduleEditPage"
             x:DataType="vm:ScheduleEditViewModel"
             Title="">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <views:AppHeader/>

            <VerticalStackLayout Padding="20,20,20,0" Spacing="16">

                <Label Text="{Binding Title}" Style="{StaticResource PageTitle}"/>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Назва заняття" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Entry Text="{Binding Name}" Placeholder="Напр. Йога"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="День тижня" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Picker Title="Оберіть день"
                                        ItemsSource="{Binding Days}"
                                        SelectedItem="{Binding SelectedDay}"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Час початку" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <TimePicker Time="{Binding StartTime}"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Тривалість (хв)" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Entry Text="{Binding Duration}" Keyboard="Numeric" Placeholder="60"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Тренер" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Picker Title="Оберіть тренера"
                                        ItemsSource="{Binding TrainerNames}"
                                        SelectedIndex="{Binding SelectedTrainerIndex}"/>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Button Text="💾 Зберегти" Command="{Binding SaveCommand}"/>
                <Button Text="← Назад" Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButton}"/>

            </VerticalStackLayout>

            <BoxView HeightRequest="40" Color="Transparent"/>
            <views:AppFooter/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>