<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitnessClub.ViewModels"
             xmlns:views="clr-namespace:FitnessClub.Views"
             x:Class="FitnessClub.Views.Details.SpecializationEditPage"
             x:DataType="vm:SpecializationEditViewModel"
             Title="">

	<ScrollView>
		<Grid RowDefinitions="*, Auto" MinimumHeightRequest="{OnPlatform iOS=800, Android=700, WinUI=800, MacCatalyst=800}">

			<VerticalStackLayout Grid.Row="0" Spacing="0">
				<views:AppHeader/>

				<VerticalStackLayout Padding="20" Spacing="16">
					<Label Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
					<Border Style="{StaticResource Card}">
						<VerticalStackLayout Spacing="14">
							<VerticalStackLayout Spacing="6">
								<Label Text="Назва спеціалізації" Style="{StaticResource FieldLabel}"/>
								<Border Style="{StaticResource InputFrame}">
									<Entry Text="{Binding Name}" Placeholder="Напр. Кросфіт"/>
								</Border>
							</VerticalStackLayout>
						</VerticalStackLayout>
					</Border>
					<HorizontalStackLayout Spacing="12" HorizontalOptions="Start">
						<Button Text="💾"
                                Command="{Binding SaveCommand}"
                                FontSize="20" Padding="0"
                                WidthRequest="54" HeightRequest="54"
                                CornerRadius="14"
                                BackgroundColor="{StaticResource Brand}"/>
						<Button Text="←"
                                Command="{Binding CancelCommand}"
                                FontSize="22" Padding="0"
                                WidthRequest="54" HeightRequest="54"
                                CornerRadius="14"
                                Style="{StaticResource SecondaryButton}"/>
					</HorizontalStackLayout>
				</VerticalStackLayout>
			</VerticalStackLayout>

			<views:AppFooter Grid.Row="1"/>

		</Grid>
	</ScrollView>
</ContentPage>