<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitnessClub.ViewModels"
             xmlns:views="clr-namespace:FitnessClub.Views"
             x:Class="FitnessClub.Views.Details.SubscriptionEditPage"
             x:DataType="vm:SubscriptionEditViewModel"
             Title="">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <views:AppHeader/>
            <VerticalStackLayout Padding="20,20,20,0" Spacing="16">

                <Label Text="{Binding Title}" Style="{StaticResource PageTitle}"/>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Назва" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Entry Text="{Binding Name}" Placeholder="Напр. Преміум"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Опис" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Editor Text="{Binding Description}"
                                        Placeholder="Короткий опис абонемента"
                                        HeightRequest="80"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Ціна за місяць (₴)" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Entry Text="{Binding Price}" Keyboard="Numeric" Placeholder="0"/>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Керування послугами -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Послуги абонемента" Style="{StaticResource FieldLabel}"/>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Services}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ServiceSelectionItem">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Name}"
                                               VerticalOptions="Center"/>
                                        <Switch Grid.Column="1" IsToggled="{Binding IsSelected}"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout Spacing="12" HorizontalOptions="Start">
                    <Button Text="💾"
                            Command="{Binding SaveCommand}"
                            FontSize="20" Padding="0"
                            WidthRequest="54" HeightRequest="54"
                            CornerRadius="14"
                            BackgroundColor="{StaticResource Brand}"/>
                    <Button Text="←"
                            Command="{Binding CancelCommand}"
                            FontSize="22" Padding="0"
                            WidthRequest="54" HeightRequest="54"
                            CornerRadius="14"
                            Style="{StaticResource SecondaryButton}"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>
            <BoxView HeightRequest="40" Color="Transparent"/>
            <views:AppFooter/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>