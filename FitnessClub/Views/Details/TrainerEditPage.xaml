<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitnessClub.ViewModels"
             xmlns:views="clr-namespace:FitnessClub.Views"
             x:Class="FitnessClub.Views.Details.TrainerEditPage"
             x:DataType="vm:TrainerEditViewModel"
             Title="">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <views:AppHeader/>
            <VerticalStackLayout Padding="20,20,20,0" Spacing="16">

                <Label Text="{Binding Title}" Style="{StaticResource PageTitle}"/>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Прізвище" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Entry Text="{Binding LastName}" Placeholder="Введіть прізвище"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Ім'я" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Entry Text="{Binding FirstName}" Placeholder="Введіть ім'я"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="По батькові" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Entry Text="{Binding MiddleName}" Placeholder="Введіть по батькові"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Спеціалізація" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Entry Text="{Binding Specialization}" Placeholder="Напр. Силові тренування"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Досвід (років)" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Entry Text="{Binding Experience}" Keyboard="Numeric" Placeholder="0"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Фото (назва файлу)" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Entry Text="{Binding Photo}" Placeholder="Напр. trainer1.jpg"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Телефон" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Entry Text="{Binding Phone}" Keyboard="Telephone" Placeholder="+38..."/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource InputFrame}">
                                <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="email@..."/>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Компактні кнопки-іконки зліва -->
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Start">
                    <Button Text="💾"
                            Command="{Binding SaveCommand}"
                            FontSize="20" Padding="0"
                            WidthRequest="54" HeightRequest="54"
                            CornerRadius="14"
                            BackgroundColor="{StaticResource Brand}"/>
                    <Button Text="←"
                            Command="{Binding CancelCommand}"
                            FontSize="22" Padding="0"
                            WidthRequest="54" HeightRequest="54"
                            CornerRadius="14"
                            Style="{StaticResource SecondaryButton}"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>
            <BoxView HeightRequest="40" Color="Transparent"/>
            <views:AppFooter/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>