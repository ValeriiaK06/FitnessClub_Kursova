<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitnessClub.ViewModels"
             x:Class="FitnessClub.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Title="">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource Brand}" Offset="0"/>
                <GradientStop Color="{StaticResource Accent}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout VerticalOptions="Center" Padding="30" Spacing="16">

                <Label Text="🔑 Відновлення пароля"
                       FontFamily="OpenSansSemibold" FontSize="26"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource White}"/>

                <!-- Секретне питання -->
                <Label Text="{Binding Question}"
                       FontSize="15"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Gray100}"/>

                <Border BackgroundColor="{StaticResource White}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        Padding="14,2">
                    <Entry Text="{Binding Answer}"
                           Placeholder="Ваша відповідь"
                           IsEnabled="{Binding IsAnswerConfirmed, Converter={StaticResource InvertBoolConverter}}"
                           TextColor="{StaticResource Gray900}"
                           PlaceholderColor="{StaticResource Gray500}"/>
                </Border>

                <!-- Кнопка перевірки відповіді -->
                <Button Text="Перевірити відповідь"
                        Command="{Binding ConfirmAnswerCommand}"
                        IsVisible="{Binding IsAnswerConfirmed, Converter={StaticResource InvertBoolConverter}}"
                        FontSize="15" HeightRequest="48"
                        CornerRadius="12"
                        BackgroundColor="{StaticResource White}"
                        TextColor="{StaticResource Brand}"/>

                <!-- Поле нового пароля (після підтвердження) -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsAnswerConfirmed}">
                    <Border BackgroundColor="{StaticResource White}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 12"
                            Padding="14,2">
                        <Entry Text="{Binding NewPassword}"
                               Placeholder="Новий пароль"
                               IsPassword="True"
                               TextColor="{StaticResource Gray900}"
                               PlaceholderColor="{StaticResource Gray500}"/>
                    </Border>

                    <Button Text="Зберегти новий пароль"
                            Command="{Binding SaveNewPasswordCommand}"
                            FontSize="15" HeightRequest="48"
                            CornerRadius="12"
                            BackgroundColor="{StaticResource White}"
                            TextColor="{StaticResource Brand}"/>
                </VerticalStackLayout>

                <Button Text="← Назад"
                        Command="{Binding CancelCommand}"
                        FontSize="14" HeightRequest="44"
                        CornerRadius="12"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource White}"
                        BorderColor="{StaticResource White}"
                        BorderWidth="1"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>