<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FitnessClub.Models"
             xmlns:vm="clr-namespace:FitnessClub.ViewModels"
             xmlns:views="clr-namespace:FitnessClub.Views"
             x:Class="FitnessClub.Views.SpecializationsPage"
             x:DataType="vm:SpecializationsViewModel"
             x:Name="PageRoot"
             Title="">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <views:AppHeader/>

            <VerticalStackLayout Padding="20,20,20,0" Spacing="16">

                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="🏷️ Спеціалізації" Style="{StaticResource PageTitle}"/>
                        <Label Text="Напрями тренувань" Style="{StaticResource SubtitleLabel}"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="1" Text="＋"
                            Command="{Binding AddCommand}"
                            FontSize="22" FontAttributes="Bold"
                            WidthRequest="48" HeightRequest="48"
                            Padding="0" CornerRadius="14"
                            VerticalOptions="Center"/>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="0"
                        MaximumWidthRequest="1100" HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,12"
                              BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">
                            <Label Grid.Column="0"  Margin="0,0,16,0"
                                   FontFamily="OpenSansSemibold" FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}"/>
                            <Label Grid.Column="1" Text="НАЗВА"
                                   FontFamily="OpenSansSemibold" FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}"/>
                            <Label Grid.Column="2" Text="ДІЇ"
                                   FontFamily="OpenSansSemibold" FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}"/>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Specializations}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Specialization">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,12" ColumnSpacing="12">

                                        <Border Grid.Column="0"
                                                BackgroundColor="{StaticResource Accent}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                                WidthRequest="36" HeightRequest="36"
                                                VerticalOptions="Center">
                                            <Label Text="🏷️" FontSize="16"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>

                                        <Label Grid.Column="1" Text="{Binding Name}"
                                               FontSize="15" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"/>

                                        <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                            <Button Text="✏️"
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    FontSize="13" Padding="0"
                                                    WidthRequest="34" HeightRequest="34"
                                                    CornerRadius="10"
                                                    BackgroundColor="{StaticResource Brand}"/>
                                            <Button Text="🗑"
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    FontSize="13" Padding="0"
                                                    WidthRequest="34" HeightRequest="34"
                                                    CornerRadius="10"
                                                    BackgroundColor="{StaticResource Danger}"/>
                                        </HorizontalStackLayout>

                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <BoxView HeightRequest="60" Color="Transparent"/>
            <views:AppFooter/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>