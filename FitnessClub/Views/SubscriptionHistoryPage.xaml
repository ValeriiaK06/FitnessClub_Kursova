<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FitnessClub.Models"
             xmlns:vm="clr-namespace:FitnessClub.ViewModels"
             xmlns:views="clr-namespace:FitnessClub.Views"
             x:Class="FitnessClub.Views.SubscriptionHistoryPage"
             x:DataType="vm:SubscriptionHistoryViewModel"
             Title="">

	<ScrollView x:Name="PageScroll">
		<Grid RowDefinitions="Auto,*,Auto"
              MinimumHeightRequest="{Binding Height, Source={x:Reference PageScroll}}">

			<!-- ШАПКА -->
			<views:AppHeader Grid.Row="0"/>

			<!-- КОНТЕНТ -->
			<VerticalStackLayout Grid.Row="1" Padding="20,20,20,0" Spacing="16">

				<VerticalStackLayout Spacing="2">
					<Label Text="📜 Історія абонементів" Style="{StaticResource PageTitle}"/>
					<Label Text="Журнал усіх змін" Style="{StaticResource SubtitleLabel}"/>
				</VerticalStackLayout>

				<VerticalStackLayout BindableLayout.ItemsSource="{Binding History}" Spacing="10">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="models:SubscriptionHistory">

							<Border Style="{StaticResource Card}" Padding="14">
								<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">

									<Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding ClientName}"
                                           FontFamily="OpenSansSemibold" FontSize="15"
                                           TextColor="{StaticResource Brand}"/>

									<Border Grid.Row="0" Grid.Column="1"
                                            BackgroundColor="{StaticResource Accent}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                            Padding="9,3" VerticalOptions="Center">
										<Label Text="{Binding ActionType}" FontSize="11"
                                               TextColor="{StaticResource White}"/>
									</Border>

									<Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding PlanName, StringFormat='💳 {0}'}"
                                           FontSize="13" Margin="0,6,0,0"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"/>

									<Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Details}"
                                           FontSize="12" Margin="0,4,0,0"
                                           TextColor="{AppThemeBinding Light={StaticResource SubTextLight}, Dark={StaticResource SubTextDark}}"/>

									<Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding ActionDate, StringFormat='🕐 {0:dd.MM.yyyy HH:mm}'}"
                                           Style="{StaticResource SubtitleLabel}" Margin="0,2,0,0"/>

								</Grid>
							</Border>

						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>

			</VerticalStackLayout>

			<!-- ФУТЕР -->
			<views:AppFooter Grid.Row="2" Margin="0,40,0,0"/>

		</Grid>
	</ScrollView>
</ContentPage>