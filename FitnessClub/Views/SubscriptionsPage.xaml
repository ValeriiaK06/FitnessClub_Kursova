<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:FitnessClub.Views"
             x:Class="FitnessClub.Views.SubscriptionsPage"
             Shell.NavBarIsVisible="False">
	<Grid RowDefinitions="*,Auto">
		<ScrollView Grid.Row="0">
			<VerticalStackLayout Padding="20" Spacing="8">
				<Label Text="💳 Абонементи" Style="{StaticResource PageTitle}"/>
				<Label Text="Розділ у розробці" Style="{StaticResource SubtitleLabel}"/>
			</VerticalStackLayout>
		</ScrollView>

		<views:AppFooter Grid.Row="1"/>
	</Grid>
</ContentPage>